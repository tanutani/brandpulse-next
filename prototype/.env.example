# Copy to .env.local and fill in. .env.local is gitignored; this file is committed,
# so it must never contain a real key.

# Demo mode. "static" never contacts a provider. "hybrid" allows the bounded
# live steps below, each with the checked-in fixture behind it.
DEMO_MODE=static

# Master switch. Live AI requires BOTH LIVE_AI_ENABLED=true and DEMO_MODE=hybrid.
LIVE_AI_ENABLED=false

# Server-only Gemini key, used by all three live steps (evidence extraction,
# synthesis, and the Skeptic). Never prefixed with NEXT_PUBLIC_ and never sent
# to the browser. Leave it unset: the full journey completes without it.
# Put the real value in .env.local, which is gitignored. This file is committed.
# GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.5-flash-lite.
# BRANDPULSE_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# Not configured here
# -----------------------------------------------------------------------------
# GDELT (the live evidence source) is an open API with no key and no account,
# so there is nothing to set. It is read server-side only.
#
# Appending ?static=1 to any URL forces full offline mode for that session,
# whatever the settings above say. Use it when demo wifi is unreliable. There is
# deliberately no URL flag that turns live mode ON: that stays a server decision.
