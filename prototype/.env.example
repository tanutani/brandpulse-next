# Demo mode. "static" never contacts a provider. "hybrid" allows one bounded
# server-side Gemini synthesis call with the checked-in fallback behind it.
DEMO_MODE=static

# Master switch. Live AI requires BOTH LIVE_AI_ENABLED=true and DEMO_MODE=hybrid.
LIVE_AI_ENABLED=false

# Server-only Gemini key. Never prefixed with NEXT_PUBLIC_ and never sent to the
# browser. Leave it unset: the full journey completes without it.
# GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.5-flash-lite.
# BRANDPULSE_MODEL=gemini-3.5-flash-lite
